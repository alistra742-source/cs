# Build context excludes. Only things the RUNTIME never imports.
# NOTE: trainer.py, make_longtail.py, live_control.py and live_ui.py are
# imported by app.py / hcaptcha_types.py at startup — they must ship.
.git
.gitignore
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.env.*
*.log
.DS_Store

# Docs and dev-only artefacts
SOLVER.md
preview_*.jpg
